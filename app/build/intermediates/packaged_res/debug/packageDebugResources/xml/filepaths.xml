<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Expose the app's internal cache directory (Context.cacheDir) so the
         FileProvider can serve generated clinical export files to other apps. -->
    <cache-path
        name="exports"
        path="." />

    <!-- Full-resolution meal photos captured for barcode scanning. -->
    <cache-path
        name="meal_photos"
        path="meal_photos/" />
</paths>
